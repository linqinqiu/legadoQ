{
  "name": "legado-web",
  "private": true,
  "version": "0.0.8",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "keywords": [
    "legado",
    "legado3",
    "reader",
    "novel-reader",
    "react19",
    "pwa",
    "tts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "check:test": "tsc -p tsconfig.test.json --pretty false",
    "test": "tsx test/run-all.ts",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --reporter=html --reporter=lcov --reporter=json-summary --include='src/**/*.ts' --include='src/**/*.tsx' --exclude='src/**/*.d.ts' --exclude='src/reader/dict/**' --all=false tsx test/run-all.ts",
    "test:e2e": "tsx test/e2e-browser-stress.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.6.0",
    "hls.js": "^1.7.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "c8": "^12.0.0",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.23.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
