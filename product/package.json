{
  "name": "legado",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "legadoQ — 本地阅读服务（Kotlin/Ktor 后端 + 内置 Web UI）",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "legado",
    "legado3",
    "reader",
    "novel-reader",
    "book-source",
    "headless",
    "ktor",
    "kotlin",
    "react",
    "pwa",
    "tts",
    "docker"
  ],
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "test": "node scripts/tasks.mjs test",
    "check": "npm --prefix web run check",
    "dev": "npm --prefix web run dev",
    "start": "node start.mjs",
    "coverage": "node scripts/coverage-report.mjs",
    "coverage:report-only": "node scripts/coverage-report.mjs --skip-run --json",
    "docs:api": "node scripts/gen-api-reference.mjs",
    "docs:api-check": "node scripts/gen-api-reference.mjs --check",
    "changelog": "node scripts/changelog.mjs",
    "changelog:dry": "node scripts/changelog.mjs --dry-run",
    "changelog:check": "node scripts/changelog.mjs --check",
    "version:check": "node scripts/version-check.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linqinqiu/legadoQ.git"
  },
  "bugs": {
    "url": "https://github.com/linqinqiu/legadoQ/issues"
  },
  "homepage": "https://github.com/linqinqiu/legadoQ#readme"
}
