{
  "name": "legadoq-ai-framework",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "legadoQ - 本地阅读服务（后端与内置 UI 在 product）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm --prefix product start",
    "stop": "node product/stop.mjs",
    "build": "npm --prefix product run build",
    "test": "npm --prefix product test",
    "test:scripts": "npm --prefix product run test:scripts",
    "doctor": "npm --prefix product run doctor --",
    "pr": "npm --prefix product run pr",
    "full": "npm --prefix product run full",
    "release:check": "npm --prefix product run release:check",
    "dev": "npm --prefix product run dev",
    "build:bump": "node scripts/version.mjs bump-build",
    "version:show": "node scripts/version.mjs show",
    "protocol:sync": "node scripts/protocol.mjs",
    "protocol:check": "node scripts/protocol.mjs --check",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  }
}
